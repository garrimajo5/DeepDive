class_name Species
## Реестр видов отмели — перенос G.SPECIES и G.SPECIES_ORDER из js/creatures.js (Unity `Core/Species.cs`): 26 видов
## в порядке журнала, тексты один в один. У вида настоящее имя с падежами (после сканирования) и описательное до него
## («мелкая рыба»), описание и заметки для журнала: ключ наблюдения (как note в EcoBus.emit) и текст.
## Пустые gen/ugen — берётся винительный, как `s.gen || s.acc` в браузере. Новые виды из docs/bestiary.md — в конец.

## Падеж названия (G.nm): именительный, винительный, родительный.
enum Case { NOM, ACC, GEN }


## Вид отмели — обёртка над строкой ALL (только чтение).
class Info:
	extends RefCounted
	var id: String
	var name: String   ## настоящее имя с заглавной: «Светляк-полосник»
	var acc: String
	var gen: String
	var unom: String   ## до сканирования: «мелкая рыба»
	var uacc: String
	var ugen: String
	var desc: String
	var notes: Array   ## [[ключ, текст], …] в порядке журнала

	func _init(d: Dictionary) -> void:
		id = d["id"]
		name = d["name"]
		acc = d["acc"]
		gen = d["gen"]
		unom = d["unom"]
		uacc = d["uacc"]
		ugen = d["ugen"]
		desc = d["desc"]
		notes = d["notes"]

	## Есть ли у вида заметка журнала с таким ключом.
	func has_note(key: String) -> bool:
		return note(key) != ""

	## Текст заметки журнала; "" — нет такой.
	func note(key: String) -> String:
		for n in notes:
			if n[0] == key:
				return n[1]
		return ""

	## Название в падеже: настоящее после сканирования, описательное до (G.nm).
	func called(c: Case = Case.NOM, scanned: bool = false) -> String:
		if scanned:
			match c:
				Case.GEN: return gen if gen != "" else acc
				Case.ACC: return acc
				_: return name.to_lower()
		match c:
			Case.GEN: return ugen if ugen != "" else uacc
			Case.ACC: return uacc
			_: return unom



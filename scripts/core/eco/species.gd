## Номер вида по ключу — строится при первом обращении (только числа, без объектов: ничего не держит при выходе).
static var _index: Dictionary = {}


static func count() -> int:
	return ALL.size()


## Ключи видов в порядке журнала.
static func ids() -> Array[String]:
	var out: Array[String] = []
	for d in ALL:
		out.append(d["id"])
	return out


static func has(id: String) -> bool:
	return index_of(id) >= 0


## Номер вида в порядке журнала, −1 — нет такого.
static func index_of(id: String) -> int:
	if _index.is_empty():
		for i in ALL.size():
			_index[ALL[i]["id"]] = i
	return _index.get(id, -1)


## Вид по ключу; null — нет такого.
static func info(id: String) -> Info:
	var i := index_of(id)
	return Info.new(ALL[i]) if i >= 0 else null


## Название вида в падеже (G.nm); "" — нет такого вида.
static func called(id: String, c: Case = Case.NOM, scanned: bool = false) -> String:
	var s := info(id)
	return s.called(c, scanned) if s else ""


## Наблюдение ли это для журнала: у вида есть заметка с таким ключом (IsObservation).
static func is_observation(id: String, key: String) -> bool:
	var s := info(id)
	return s != null and s.has_note(key)


## Первая буква заглавная (G.cap).
static func cap(s: String) -> String:
	return s if s.is_empty() else s.left(1).to_upper() + s.substr(1)

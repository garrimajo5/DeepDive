class_name EcoField
extends RefCounted
## Наблюдение поля — место 08 слоя 1 (#831, часть 2; карта #818, `LayerMap.POINTS["08"]`): боковая площадка на гребне
## у конца ответвления 07→08, откуда открыт вид на запад, на будущее поле. Жизнь здесь редкая: только два веерника
## по бокам площадки — стоят поперёк течения, и по ним с площадки видно, куда несёт воду (EcoFan). Ни стай, ни рощ,
## ни кустов: запад от точки свободен (веерники не западнее середины), проход 07→08 свободен (дальше `CLEAR` м от его
## оси). Само поле — отдельная задача. Своих существ и шага нет: места берёт EcoFan.default_spots.

const ID := "field"
## Середина площадки (x, z) — та же точка, что `LayerMap.xz("08")` и `Run.PLACES["field"]`.
const CENTER := Vector2(-250.0, -210.0)
## Веерники (x, z): к северу и к югу от площадки, ≈ 40–50 м от середины, не западнее её — вид на запад открыт.
const FANS: Array[Vector2] = [Vector2(-238.0, -168.0), Vector2(-236.0, -256.0)]
## Не ближе этого к оси прохода (м): полоса прохода `Seabed.Layer.LANE_HALF` (32) + запас под ширину веера.
const CLEAR := 36.0

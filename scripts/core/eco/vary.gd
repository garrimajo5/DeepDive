class_name EcoVary
extends RefCounted
## Разброс особей в стае (`docs/grafika-plan-eco.md`, Б4 «Вариативность в MultiMesh»): у каждой особи свой размер,
## оттенок и ритм — стая перестаёт выглядеть клонами. Число берётся из номера особи и «соли» свойства хешем, а не из
## генератора случая мира: поведение и порядок случайных чисел мира не меняются, вид особи один и тот же на хосте
## и у гостя сети. Разброс даром для кадра — те же вызовы отрисовки и шейдеры, поэтому выключателя «Экономно» нет.

## Соли свойств (разные свойства одной особи не связаны между собой).
const SIZE := 1
const SHADE := 2
const RATE := 3
const HUE := 4


## Число в [0, 1) для особи i и свойства salt; одно и то же при каждом вызове.
static func unit(i: int, salt: int) -> float:
	var h := (i * 374761393 + salt * 668265263 + 1442695041) & 0xFFFFFFFF
	h = ((h ^ (h >> 13)) * 1274126177) & 0xFFFFFFFF
	h = h ^ (h >> 16)
	return float(h & 0xFFFFFF) / 16777216.0


## Множитель 1 ± amp для особи i и свойства salt (ровно по всему отрезку).
static func spread(i: int, salt: int, amp: float) -> float:
	return 1.0 + (unit(i, salt) * 2.0 - 1.0) * amp

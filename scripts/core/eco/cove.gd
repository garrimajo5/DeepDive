class_name EcoCove
extends RefCounted
## Тихая заводь — место 09 слоя 1 (#831, карта #818, `LayerMap.POINTS["09"]`): песчаный карман за грядой с широким
## разворотом. Понятное укрытие из того, что игрок уже знает на отмели: трубный орган (гул прячет двигатели от
## серпохвоста, EcoOrgan), куст огнецвета — станция чистки огнёвок (у неё хищник не охотится, EcoCoral/EcoLeech)
## и роща ленточника с шипоежами (EcoKelp). Своей стаи у заводи нет — основной маршрут хищника (дома стай EcoFish)
## сюда не ведёт, но патруль может зайти: вода не «магически безопасная». Всё стоит по краю круга разворота
## (`Seabed.Layer.POCKET_R`) и дальше `CLEAR` м от проходов — середина кармана и проходы свободны для корабля.
## Своих существ и шага нет: места берут модули видов (EcoOrgan.SPOTS, EcoCoral.BASES, EcoKelp.EXTRA).

const ID := "cove"
## Середина заводи (x, z) — та же точка, что `LayerMap.xz("09")` и `Run.PLACES["cove"]`.
const CENTER := Vector2(-80.0, 160.0)
## Губка органа, куст огнецвета и середина рощи ленточника (x, z) — дальняя от проходов сторона кармана, ≈ 48 м от
## середины, друг от друга ≥ 35 м (гул органа 22 м и укрытие станции 14 м не сливаются в одно пятно).
const ORGAN := Vector2(-118.0, 188.0)
const CORAL := Vector2(-82.0, 208.0)
const KELP := Vector2(-46.0, 194.0)
## Укрытия не ближе этого к оси прохода (м): полоса прохода `Seabed.Layer.LANE_HALF` (32) + запас под ширину рощи.
const CLEAR := 36.0


## Все места укрытий заводи (x, z): орган, огнецвет, ленточник.
static func spots() -> Array[Vector2]:
	return [ORGAN, CORAL, KELP]

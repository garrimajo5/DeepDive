class_name EcoGate
extends RefCounted
## Терраса врат — место 07 слоя 1 (#831, часть 3; карта #818, `LayerMap.POINTS["07"]`): главная сюжетная точка
## слоя — выращенная арка врат на гребне (её ставит поток А по ART-079). Живая обвязка вокруг будущей арки —
## флора гребня из того, что игрок уже знает: две рощи ленточника с шипоежами позади арки, к северу (−Z), по обе
## стороны — как раму, и два веерника поперёк течения у сходов с террасы (юго-запад и восток). Стай и своих
## существ у врат нет; всё стоит дальше `POCKET` м от середины (карман разворота `Seabed.Layer.POCKET_R` и место
## под арку свободны) и дальше `CLEAR` м от четырёх проходов 01/03/04/08 → 07. Шага нет: места берут модули видов
## (EcoKelp.EXTRA, EcoFan.default_spots).

const ID := "gate"
## Середина террасы (x, z) — та же точка, что `LayerMap.xz("07")` и `Run.PLACES["gate"]`.
const CENTER := Vector2(-100.0, -240.0)
## Рощи ленточника (x, z): позади арки к северу, по обе стороны, ≈ 55 м от середины и ≈ 64 м друг от друга.
const KELP: Array[Vector2] = [Vector2(-132.0, -284.0), Vector2(-68.0, -284.0)]
## Веерники (x, z): у сходов с террасы — к юго-западу (к заводи и Костям) и к востоку (к Раковине), ≈ 57 м.
const FANS: Array[Vector2] = [Vector2(-120.0, -186.0), Vector2(-43.0, -256.0)]
## Обвязка не ближе этого к середине (м): карман разворота (46) + запас — место под арку и разворот свободны.
const POCKET := 50.0
## Не ближе этого к оси прохода (м): полоса прохода `Seabed.Layer.LANE_HALF` (32) + запас под ширину рощи.
const CLEAR := 36.0


## Все места обвязки (x, z): рощи и веерники.
static func spots() -> Array[Vector2]:
	var out: Array[Vector2] = []
	out.append_array(KELP)
	out.append_array(FANS)
	return out

class_name EcoGate
extends RefCounted
## Терраса врат — место 07 слоя 1 (#831, часть 3; карта #818, `LayerMap.POINTS["07"]`): главная сюжетная точка
## слоя — выращенная арка врат на гребне (её ставит поток А по ART-079). Живая обвязка вокруг будущей арки —
## флора гребня из того, что игрок уже знает: две рощи ленточника с шипоежами и два веерника — по бокам жёлоба
## прохода (#1757: под модель MOD-023 пол у арки углубляется жёлобом вдоль Z, рамка — на гребне за его склонами,
## в полосах `STRIP` по |dx|, |dz| ≤ `STRIP_DZ`, на прежней стороне). Стай и своих существ у врат нет; всё стоит
## дальше `POCKET` м от середины, дальше `CLEAR` м от четырёх проходов 01/03/04/08 → 07, всем объёмом (`REACH`) — вне
## жёлоба и его склонов (`TROUGH_HALF` + `TROUGH_SLOPE`). Шага нет: места берут модули видов
## (EcoKelp.EXTRA, EcoFan.default_spots).
const ID := "gate"
## Середина террасы (x, z) — та же точка, что `LayerMap.xz("07")` и `Run.PLACES["gate"]`.
const CENTER := Vector2(-100.0, -240.0)
## Рощи ленточника (x, z): к северу от оси (−Z), по обе стороны жёлоба — западная за левой опорой (dx −72,
## dz −44), восточная у правой опоры (dx +70, dz −10): севернее восточная полоса уходит с гребня (дно ниже 51 м)
## и упирается в нишу купольника `EcoDome.HOME_OFF` и его путь к гнезду.
const KELP: Array[Vector2] = [Vector2(-172.0, -284.0), Vector2(-30.0, -250.0)]
## Веерники (x, z): западный — у схода с террасы к юго-западу (к заводи и Костям, dx −72, dz +56), восточный —
## за нишей купольника к северу (dx +65, dz −60): у схода к Раковине полоса ближе 35 м к восточной роще.
const FANS: Array[Vector2] = [Vector2(-172.0, -184.0), Vector2(-35.0, -300.0)]
## Жёлоб прохода под аркой MOD-023 (#1757, вариант уровней 13.11): пол в |dx| ≤ TROUGH_HALF, |dz| ≤ STRIP_DZ от
## середины, боковые склоны TROUGH_SLOPE м. Рамка — в полосах STRIP.x ≤ |dx| ≤ STRIP.y, |dz| ≤ STRIP_DZ.
const TROUGH_HALF := 28.0
const TROUGH_SLOPE := 30.0
const STRIP := Vector2(65.0, 85.0)
const STRIP_DZ := 60.0
## Объём растения от его места по горизонтали, м: роща — круг лент `EcoKelp.KELP_R` и наклон самой высокой ленты
## (`H_MAX`·`TILT`), веерник — полширины.
const KELP_REACH := 7.5
const FAN_REACH := 1.3
## Обвязка не ближе этого к середине (м): карман разворота (46) + запас — место под арку и разворот свободны.
const POCKET := 50.0
## Не ближе этого к оси прохода (м): полоса прохода `Seabed.Layer.LANE_HALF` (32) + запас под ширину рощи.
const CLEAR := 36.0


## Все места обвязки (x, z): рощи и веерники.
static func spots() -> Array[Vector2]:
	var out: Array[Vector2] = []
	out.append_array(KELP)
	out.append_array(FANS)
	return out
